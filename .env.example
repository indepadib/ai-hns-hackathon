# Secrets in Netlify Functions environment only; never commit real values.
HNS_SESSION_SECRET=
HNS_ADMIN_KEY=
HNS_RH_KEY=
HNS_JURY_KEY=
# Preserve the existing production credentials.
HNS_ADMIN_TOKEN=
HNS_NETLIFY_API_TOKEN=
# Only on the original ai.hns.ma Netlify project, production context.
HNS_UNIFIED_PRODUCTION=false
HNS_INVITATION_SEND_ENABLED=false
HNS_RESEND_API_KEY=
HNS_INVITATION_FROM=
# Optional existing receipt-email provider configuration.
RESEND_API_KEY=
HNS_EMAIL_FROM=
HNS_REPLY_TO=
HNS_EVENT_LOCATION=
# Optional server-to-server integration key (not required by the existing RH UI).
HNS_RECRUITMENT_BRIDGE_KEY=
